<UserControl x:Class="TrackLink.Windows.UI.DevicePickerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="触控板设备" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="在笔记本触控板上单指来回滑动，然后点「开始 3 秒检测」——正在产生事件的那块设备会被高亮。确认无误后点「就用它」，程序会记住这块触控板，下次启动不再询问。"/>

        <Border x:Name="UnsupportedBorder" Grid.Row="2" Background="#FFFFF4E5" BorderBrush="#FFE0A030"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="UnsupportedText" TextWrapping="Wrap" Foreground="#FF7A4A00"/>
        </Border>

        <!-- 必须禁用横向滚动条：否则 ListBox 会给子项无限宽度，卡片里的设备路径不会换行、被窗口边缘裁掉。 -->
        <ListBox x:Name="DeviceList" Grid.Row="3" Margin="0,10,0,0" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" CornerRadius="4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF7F7F7"/>
                                <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="#FFE3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF666666" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Activity}" Foreground="#FF007ACC" FontSize="11"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ScanButton" Content="开始 3 秒检测" Width="120" Height="30" Margin="0,0,8,0"
                    Click="OnScan"/>
            <Button x:Name="UseButton" Content="就用它" Width="96" Height="30" Margin="0,0,16,0"
                    Click="OnUseSelected"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#FF555555" Text=""/>
        </StackPanel>
    </Grid>
</UserControl>