<UserControl x:Class="TrackLink.Windows.UI.DevicePickerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrackLink.Windows.UI">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题：左侧一枚金色菱形装饰 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="9" Height="9" Fill="{StaticResource GoldDeepBrush}" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock Text="触控板设备" Style="{StaticResource PageTitle}" Margin="10,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Text="在笔记本触控板上单指来回滑动，然后点「开始 3 秒检测」——正在产生事件的那块设备会被高亮。确认无误后点「就用它」，程序会记住这块触控板，下次启动不再询问。"/>

            <!-- 本页状态表情：具体含义由 Refresh 里的 ComputeSticker 决定 -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Width="120">
                <ui:Sticker x:Name="PageSticker" Key="Welcome" Size="96" Float="True" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PageStickerCaption" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{StaticResource TextWeakBrush}" FontSize="11"
                           TextAlignment="Center" TextWrapping="Wrap" Text="欢迎使用"/>
            </StackPanel>
        </Grid>

        <Border x:Name="UnsupportedBorder" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed"
                Background="#FCEEDC" BorderBrush="{StaticResource BadBrush}"
                BorderThickness="1.4" CornerRadius="10" Padding="12">
            <StackPanel Orientation="Horizontal">
                <ui:Sticker Key="Shock" Size="54" VerticalAlignment="Top"/>
                <TextBlock x:Name="UnsupportedText" TextWrapping="Wrap" Margin="12,0,0,0"
                           Foreground="#8A2F16" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 必须禁用横向滚动条：否则 ListBox 会给子项无限宽度，卡片里的设备路径不会换行、被窗口边缘裁掉。 -->
            <ListBox x:Name="DeviceList" Grid.Row="0" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- DeviceCard：IsHighlighted=true 时换成金色高亮描边，鼠标悬停会浮起 -->
                        <ContentControl Style="{StaticResource DeviceCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSubBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Activity}" Foreground="{StaticResource GoldDeepBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ScanButton" Content="开始 3 秒检测" MinWidth="132" Click="OnScan"/>
                <Button x:Name="UseButton" Content="就用它" Style="{StaticResource GhostButton}"
                        MinWidth="96" Margin="8,0,16,0" Click="OnUseSelected"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSubBrush}" FontSize="11.5" Text=""
                           MaxWidth="420"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                BorderBrush="#40D3BC8E">
            <TextBlock Text="程序不按名称或 VID:PID 猜哪块是触控板，只认「检测窗口里真的在产生多触点事件的设备」。"
                       Foreground="{StaticResource TextWeakBrush}" FontSize="10.5" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>