<UserControl x:Class="TrackLink.Windows.UI.SettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrackLink.Windows.UI">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Rectangle Width="9" Height="9" Fill="{StaticResource GoldDeepBrush}" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Text="手势设置" Style="{StaticResource PageTitle}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource TextWeakBrush}" FontSize="11"
                       Text="改动立即生效，无需重启监听"/>
        </Grid>

        <ContentControl Grid.Row="1" Style="{StaticResource GenshinCard}">
            <StackPanel>
                <TextBlock Text="光标灵敏度" FontWeight="Bold"/>
                <TextBlock Text="触控板走满一个轴时手机光标移动几屏。数值越大越跟手。"
                           Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,3,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MoveGainSlider" Grid.Column="0" Minimum="0.5" Maximum="5.0"
                            SmallChange="0.1" LargeChange="0.5" ValueChanged="OnMoveGainChanged"/>
                    <TextBlock x:Name="MoveGainText" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}"/>
                </Grid>
            </StackPanel>
        </ContentControl>

        <ContentControl Grid.Row="2" Style="{StaticResource GenshinCard}" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="EdgeCheck" Content="边缘加速" FontWeight="Bold" Click="OnEdgeChanged"/>
                <TextBlock Text="手指落在触控板边缘区时把位移放大，弥补边缘处行程不足。"
                           Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeFactorSlider" Grid.Column="0" Minimum="1.0" Maximum="3.0"
                            SmallChange="0.1" LargeChange="0.5" ValueChanged="OnEdgeFactorChanged"/>
                    <TextBlock x:Name="EdgeFactorText" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldDeepBrush}"/>
                </Grid>
            </StackPanel>
        </ContentControl>

        <ContentControl Grid.Row="3" Style="{StaticResource GenshinCard}" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="ReverseScrollCheck" Content="反向滚动" FontWeight="Bold"
                          Click="OnReverseScrollChanged"/>
                <TextBlock Text="开启后双指上滑变成向下滚动（与 macOS「自然滚动」相反）。"
                           Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ContentControl>

        <ContentControl Grid.Row="4" Style="{StaticResource GenshinCard}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="安全停止热键" FontWeight="Bold"/>
                    <TextBlock Text="随时按一下立刻暂停手势转发（再按一次恢复），用于光标失控时急停。"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,3,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="HotkeyCombo" Width="170" SelectionChanged="OnHotkeyChanged"/>
                        <TextBlock x:Name="HotkeyStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource TextSubBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- 设置页只放一张提示表情：语义是「看一眼这里」，不做多余表情堆砌 -->
                <ui:Sticker Grid.Column="1" Key="Hint" Size="86" VerticalAlignment="Center"
                            Margin="16,0,0,0"/>
            </Grid>
        </ContentControl>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="恢复默认" MinWidth="96" Click="OnResetDefaults"/>
            <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource OkBrush}" FontSize="11.5" TextWrapping="Wrap"
                       Text=""/>
        </StackPanel>

        <TextBlock x:Name="ConfigPathText" Grid.Row="6" VerticalAlignment="Bottom" TextWrapping="Wrap"
                   Foreground="{StaticResource TextWeakBrush}" FontSize="10.5" Margin="0,16,0,0"/>
    </Grid>
</UserControl>