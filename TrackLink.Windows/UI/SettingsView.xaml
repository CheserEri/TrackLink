<UserControl x:Class="TrackLink.Windows.UI.SettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="手势设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="光标灵敏度" FontWeight="Bold"/>
                <TextBlock Text="触控板走满一个轴时手机光标移动几屏。数值越大越跟手。" Foreground="#FF777777"
                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MoveGainSlider" Grid.Column="0" Minimum="0.5" Maximum="5.0"
                            SmallChange="0.1" LargeChange="0.5" ValueChanged="OnMoveGainChanged"/>
                    <TextBlock x:Name="MoveGainText" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="14"
                Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="EdgeCheck" Content="边缘加速" FontWeight="Bold" Click="OnEdgeChanged"/>
                <TextBlock Text="手指落在触控板边缘区时把位移放大，弥补边缘处行程不足。"
                           Foreground="#FF777777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeFactorSlider" Grid.Column="0" Minimum="1.0" Maximum="3.0"
                            SmallChange="0.1" LargeChange="0.5" ValueChanged="OnEdgeFactorChanged"/>
                    <TextBlock x:Name="EdgeFactorText" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="14"
                Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="ReverseScrollCheck" Content="反向滚动" FontWeight="Bold" Click="OnReverseScrollChanged"/>
                <TextBlock Text="开启后双指上滑变成向下滚动（与 macOS「自然滚动」相反）。"
                           Foreground="#FF777777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="14"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="安全停止热键" FontWeight="Bold"/>
                <TextBlock Text="随时按一下立刻暂停手势转发（再按一次恢复），用于光标失控时急停。"
                           Foreground="#FF777777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="HotkeyCombo" Width="160" SelectionChanged="OnHotkeyChanged"/>
                    <TextBlock x:Name="HotkeyStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#FF777777" Text=""/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="恢复默认" Width="96" Height="30" Margin="0,0,12,0" Click="OnResetDefaults"/>
            <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="#FF555555" Text=""/>
        </StackPanel>

        <TextBlock x:Name="ConfigPathText" Grid.Row="6" VerticalAlignment="Bottom" TextWrapping="Wrap"
                   Foreground="#FF999999" FontSize="11" Margin="0,16,0,0"/>
    </Grid>
</UserControl>