<UserControl x:Class="TrackLink.Windows.UI.ConnectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="连接与控制" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="服务状态" Foreground="#FF666666" Margin="0,0,0,6"/>
                <TextBlock x:Name="ServiceStatusText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap"
                           Margin="0,0,0,6" Text="服务未启动"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="连接状态" Foreground="#FF666666" Margin="0,0,0,6"/>
                <TextBlock x:Name="ConnectionStatusText" Grid.Row="1" Grid.Column="1" FontWeight="Bold"
                           Margin="0,0,0,6" Text="未启动"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="远端设备" Foreground="#FF666666" Margin="0,0,0,6"/>
                <TextBlock x:Name="RemoteText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="—"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="链路往返" Foreground="#FF666666" Margin="0,0,0,6"/>
                <TextBlock x:Name="RttText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="—"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="最近手势" Foreground="#FF666666"/>
                <TextBlock x:Name="GestureText" Grid.Row="4" Grid.Column="1" Text="（暂无）"/>
            </Grid>
        </Border>

        <TextBlock x:Name="TouchpadText" Grid.Row="2" TextWrapping="Wrap" Foreground="#FF666666"
                   FontSize="11" Margin="0,10,0,0" Text="（未选定触控板）"/>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="启动服务" Width="96" Height="30" Margin="0,0,8,0"
                        Click="OnStartService"/>
                <Button x:Name="StopButton" Content="停止服务" Width="96" Height="30" Margin="0,0,8,0"
                        Click="OnStopService"/>
                <Button x:Name="DisconnectButton" Content="断开当前会话" Width="112" Height="30" Margin="0,0,8,0"
                        Click="OnDisconnectSession"/>
                <CheckBox x:Name="PauseCheck" Content="暂停控制" VerticalAlignment="Center"
                          Margin="8,0,16,0" Checked="OnPauseChanged" Unchecked="OnPauseChanged"/>
                <CheckBox x:Name="BlockCheck" Content="屏蔽本机鼠标" VerticalAlignment="Center"
                          Checked="OnBlockChanged" Unchecked="OnBlockChanged"/>
            </StackPanel>

            <TextBlock Text="勾选「屏蔽本机鼠标」后，触控板不再带动本机光标、也不在本机点击（外接鼠标不受影响）。"
                       Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock Text="运行日志" FontWeight="Bold" Margin="0,14,0,6"/>
            <ListBox x:Name="LogList" Height="220" FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动到最新" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="清空日志" Width="88" Height="26" Click="OnClearLog"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>