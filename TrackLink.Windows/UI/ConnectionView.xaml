<UserControl x:Class="TrackLink.Windows.UI.ConnectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrackLink.Windows.UI">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="9" Height="9" Fill="{StaticResource GoldDeepBrush}" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <TextBlock Text="连接与控制" Style="{StaticResource PageTitle}" Margin="10,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 状态卡：左侧五行链路信息，右侧一张大表情 -->
            <ContentControl Grid.Column="0" Style="{StaticResource GenshinCard}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="服务状态" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>
                    <TextBlock x:Name="ServiceStatusText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap"
                               Margin="0,0,0,7" Text="服务未启动"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="连接状态" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>
                    <!-- 状态文字本身带脉冲动画：连接正常时呼吸，异常时停在高亮色 -->
                    <TextBlock x:Name="ConnectionStatusText" Grid.Row="1" Grid.Column="1" FontWeight="Bold"
                               FontSize="14" Margin="0,0,0,7" Text="未启动"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="远端设备" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>
                    <TextBlock x:Name="RemoteText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,7" Text="—"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="链路往返" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RttText" Grid.Column="0" Text="—"/>
                        <!-- 心跳信号条：收到 PONG 时点亮，超时后熄灭 -->
                        <StackPanel x:Name="HeartbeatBars" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Rectangle x:Name="HeartbeatBar1" Width="4" Height="8" RadiusX="2" RadiusY="2"
                                       Margin="0,0,3,0" Fill="{StaticResource TrackBrush}"/>
                            <Rectangle x:Name="HeartbeatBar2" Width="4" Height="12" RadiusX="2" RadiusY="2"
                                       Margin="0,0,3,0" Fill="{StaticResource TrackBrush}"/>
                            <Rectangle x:Name="HeartbeatBar3" Width="4" Height="16" RadiusX="2" RadiusY="2"
                                       Margin="0,0,3,0" Fill="{StaticResource TrackBrush}"/>
                            <Rectangle x:Name="HeartbeatBar4" Width="4" Height="20" RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource TrackBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="最近手势" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="GestureText" Grid.Row="4" Grid.Column="1" Text="（暂无）"
                               TextWrapping="Wrap"/>
                </Grid>
            </ContentControl>

            <!-- 链路表情：等待 / 已连接 / 心跳超时 / 断开 / 暂停 各一张，语义完全对应 -->
            <StackPanel Grid.Column="1" Width="150" Margin="16,0,0,0" VerticalAlignment="Top">
                <ui:Sticker x:Name="LinkSticker" Key="Waiting" Size="120" Float="True"
                            HorizontalAlignment="Center"/>
                <TextBlock x:Name="LinkStickerCaption" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{StaticResource GoldDeepBrush}" FontSize="11.5" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Text="等待手机连接"/>
                <StackPanel x:Name="GestureStickerPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Visibility="Collapsed">
                    <ui:Sticker x:Name="GestureSticker" Key="Great" Size="34" VerticalAlignment="Center"/>
                    <TextBlock Text="手势识别正常" VerticalAlignment="Center" Margin="5,0,0,0"
                               Foreground="{StaticResource OkBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="TouchpadText" Grid.Row="2" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,12,0,0"
                   Text="（未选定触控板）"/>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="启动服务" MinWidth="96" Click="OnStartService"/>
                <Button x:Name="StopButton" Content="停止服务" Style="{StaticResource GhostButton}"
                        MinWidth="96" Margin="8,0,0,0" Click="OnStopService"/>
                <Button x:Name="DisconnectButton" Content="断开当前会话" Style="{StaticResource GhostButton}"
                        MinWidth="118" Margin="8,0,0,0" Click="OnDisconnectSession"/>
                <CheckBox x:Name="PauseCheck" Content="暂停控制" VerticalAlignment="Center"
                          Margin="14,0,16,0" Checked="OnPauseChanged" Unchecked="OnPauseChanged"/>
                <CheckBox x:Name="BlockCheck" Content="屏蔽本机鼠标" VerticalAlignment="Center"
                          Checked="OnBlockChanged" Unchecked="OnBlockChanged"/>
            </StackPanel>

            <TextBlock Text="勾选「屏蔽本机鼠标」后，触控板不再带动本机光标、也不在本机点击（外接鼠标不受影响）。"
                       Foreground="{StaticResource TextWeakBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                <Rectangle Width="7" Height="7" Fill="{StaticResource GoldDeepBrush}" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Text="运行日志" FontWeight="Bold" Margin="8,0,0,0"/>
            </StackPanel>
            <ListBox x:Name="LogList" Height="212" FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动到最新" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="清空日志" Style="{StaticResource GhostButton}" MinWidth="88"
                        Click="OnClearLog"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                BorderBrush="#40D3BC8E">
            <TextBlock Text="心跳：Windows 每秒发一个 PING，手机原样回 PONG；3 秒内一帧都没收到就判超时并断开，等待手机自动重连。"
                       Foreground="{StaticResource TextWeakBrush}" FontSize="10.5" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>