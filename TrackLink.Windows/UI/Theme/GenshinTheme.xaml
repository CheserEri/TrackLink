<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ 色板（原神 · 经典米黄金） ============================ -->
    <SolidColorBrush x:Key="PageBrush" Color="#ECE5D8"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F7F2E7"/>
    <SolidColorBrush x:Key="CardHiBrush" Color="#FFFBF2"/>
    <SolidColorBrush x:Key="CardDimBrush" Color="#EFE7D6"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#D3BC8E"/>
    <SolidColorBrush x:Key="GoldDeepBrush" Color="#B08D57"/>
    <SolidColorBrush x:Key="GoldHiBrush" Color="#FFE7A8"/>
    <SolidColorBrush x:Key="GoldInkBrush" Color="#7A5C1E"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#3B4255"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="#7C7466"/>
    <SolidColorBrush x:Key="TextWeakBrush" Color="#A79E8C"/>
    <SolidColorBrush x:Key="OkBrush" Color="#7BAE3F"/>
    <SolidColorBrush x:Key="BadBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D3A017"/>
    <SolidColorBrush x:Key="WaterBrush" Color="#4CC2F1"/>
    <SolidColorBrush x:Key="ElectroBrush" Color="#B08FC7"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#DED3BC"/>
    <SolidColorBrush x:Key="HoverWashBrush" Color="#1FD3BC8E"/>
    <SolidColorBrush x:Key="SelectWashBrush" Color="#40D3BC8E"/>
    <SolidColorBrush x:Key="SideTextBrush" Color="#E8DFC9"/>
    <SolidColorBrush x:Key="SideDimBrush" Color="#A99F8B"/>

    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFE7A8" Offset="0"/>
        <GradientStop Color="#E4C67F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGlowBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFF6DC" Offset="0"/>
        <GradientStop Color="#F2DFAB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#3B4255" Offset="0"/>
        <GradientStop Color="#4A5468" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDF7" Offset="0"/>
        <GradientStop Color="#F4EEDF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================ 通用文字 ============================ -->
    <!-- 只设前景色，不设 FontFamily：避免打断 ListBox（运行日志 Consolas）的字族继承。 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- 页面主标题：左侧一枚菱形装饰 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============================ 金色按钮 ============================ -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GoldInkBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource GoldBrush}"
                                Background="{StaticResource GoldGradient}"/>
                        <Border x:Name="Glow" CornerRadius="6" Opacity="0"
                                Background="{StaticResource GoldGlowBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.7" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            <Setter Property="Foreground" Value="{StaticResource TextWeakBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource GoldButton}"/>

    <!-- 次要按钮：描边风格 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource GoldButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource GoldBrush}"
                                Background="{StaticResource CardHiBrush}"/>
                        <Border x:Name="Glow" CornerRadius="6" Opacity="0" Background="{StaticResource HoverWashBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 侧栏导航按钮 ============================ -->
    <!-- 选中态由 code-behind 设置 FontWeight=Bold 表达，这里用触发器把金色指示条点亮。 -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SideTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent"/>
                        <Rectangle x:Name="Accent" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                   Fill="{StaticResource GoldHiBrush}" Opacity="0"/>
                        <Rectangle x:Name="Diamond" Width="7" Height="7" Fill="{StaticResource GoldBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter x:Name="Content" Margin="26,0,10,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                        <Trigger Property="FontWeight" Value="Bold">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFE7A8"/>
                            <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            <Setter TargetName="Diamond" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource GoldHiBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Accent"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 卡片（带悬停浮起动画） ============================ -->
    <!--
      刻意做成 ContentControl 而不是 Border：动画目标必须落在控件模板内部，
      每次实例化才会各自持有一份 TranslateTransform；若把 RenderTransform 写在 Style 里，
      同一个 Freezable 被多个元素共享，悬停一张卡会让所有卡一起动。
    -->
    <Style x:Key="GenshinCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Card" CornerRadius="10" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GoldDeepBrush}"/>
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHiBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-3" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设备列表里的高亮卡：命中检测中的那块触控板 -->
    <Style x:Key="DeviceCard" TargetType="ContentControl" BasedOn="{StaticResource GenshinCard}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="#FDF3D6"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ 复选框 ============================ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource GoldDeepBrush}"
                                Background="{StaticResource CardHiBrush}" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 1,5 L 5,9 L 12,1" Stroke="#6B4E14" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GoldGradient}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldHiBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 滑块 ============================ -->
    <Style x:Key="SliderPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPageButton}"
                                              Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{StaticResource GoldGradient}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Width="16" Height="16" Fill="{StaticResource GoldDeepBrush}"/>
                                                <Ellipse Width="9" Height="9" Fill="#FFFFF9EA"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPageButton}"
                                              Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 滚动条 ============================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPageButton}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Margin="2,1" Background="{StaticResource GoldBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPageButton}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Width" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 列表 ============================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource LogBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverWashBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectWashBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 下拉框 ============================ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="5" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverWashBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectWashBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{StaticResource GoldBrush}"
                                            Background="{StaticResource CardHiBrush}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0" Data="M 0,0 L 4.5,4.5 L 9,0"
                                              Stroke="{StaticResource GoldDeepBrush}" StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldGlowBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               Focusable="False" PopupAnimation="Fade" StaysOpen="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GoldBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,3,0,6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="#5A4A28"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
